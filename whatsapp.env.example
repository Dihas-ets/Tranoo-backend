# =============================================================================
# WHATSAPP CLOUD API (Meta) — Tranoo
# Copiez ces lignes dans votre fichier .env à la racine de tranoo-api
# =============================================================================
#
# OÙ TROUVER CHAQUE VALEUR
# ------------------------
# 1) developers.facebook.com → Vos applications → [App Tranoo] → WhatsApp → API Setup
#    - Phone number ID        → PHONE_NUMBER_ID (ou WHATSAPP_PHONE_ID)
#    - WhatsApp Business Account ID → WHATSAPP_BUSINESS_ACCOUNT_ID (optionnel, debug)
#    - Token temporaire (24h) affiché sur la page
#
# 2) Token PERMANENT (production) :
#    business.facebook.com → Paramètres business → Utilisateurs système
#    → Créer / sélectionner un utilisateur système → Ajouter des ressources (app + WABA)
#    → Générer un token → cocher whatsapp_business_messaging, whatsapp_business_management
#    → Copier le token → WHATSAPP_TOKEN (ou ACCESS_TOKEN)
#
# 3) Modèles de messages (templates) :
#    business.facebook.com → Outils WhatsApp → Gestionnaire WhatsApp
#    → Compte Tranoo → Modèles de messages → Créer
#    → Attendre le statut « Approuvé » avant les tests
#
# 4) Enregistrement du numéro (une fois) :
#    VERIFY_PIN=6 chiffres choisis par vous → node test_whatsapp_register_pin.js
#
# =============================================================================

# --- Obligatoire (OTP + rapport vérification) ---
WHATSAPP_TOKEN=
# Alias acceptés : ACCESS_TOKEN ou WHATSAPP_API_TOKEN

# Identifiant du NUMÉRO qui envoie (+229 94 06 28 93) — utilisé dans POST /{id}/messages
PHONE_NUMBER_ID=1019497624570675
# Alias : WHATSAPP_PHONE_ID
# NE PAS mettre le WABA ici (erreur Graph 100 / subcode 33)

# Compte WhatsApp Business (WABA) — Tranoo auto : 916217037413050
# Optionnel pour l'envoi OTP ; vérifier : node scripts/find_whatsapp_waba.js
WHATSAPP_BUSINESS_ACCOUNT_ID=916217037413050

# Version Graph API (laisser par défaut sauf migration Meta)
WHATSAPP_GRAPH_API_VERSION=v22.0

# --- Template 1 : OTP mot de passe oublié (Authentication) ---
# Nom EXACT du modèle créé sur Meta (sensible à la casse)
WHATSAPP_OTP_TEMPLATE_NAME=tranoo_reset_code
WHATSAPP_OTP_TEMPLATE_LANG=fr

# --- Template 2 : Rapport vérification PDF acheteur (Utility + en-tête Document) ---
WHATSAPP_VERIFICATION_TEMPLATE_NAME=tranoo_verification_rapport
WHATSAPP_VERIFICATION_TEMPLATE_LANG=fr
# Noms des variables Meta (modèle avec paramètres nommés)
WHATSAPP_VERIFICATION_PARAM_CUSTOMER_NAME=customer_name
WHATSAPP_VERIFICATION_PARAM_VEHICLE_TITLE=vehicle_title
WHATSAPP_VERIFICATION_PDF_FILENAME=rapport-verification-tranoo.pdf

# --- OTP backend (durée, longueur) ---
OTP_LENGTH=6
OTP_TTL_MS=600000
OTP_MAX_ATTEMPTS=3

# Fallback reset MDP : envoyer aussi le code par notification push (true par défaut)
# RESET_FCM_FALLBACK=true

# Logs détaillés WhatsApp (OTP [RESET][WA] + rapport PDF [VERIFY][WA] + dashboard [ADMIN][WA])
# LOG_WHATSAPP=true
# LOG_OTP=true
# NODE_ENV=development
#
# Webhook Meta (livraison réelle sent/delivered/failed dans les logs serveur)
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=tranoo_verify_secret
# URL Meta : https://VOTRE_API/api/whatsapp/webhook
# Si Meta renvoie messageId mais rien sur le téléphone :
# - Compte WhatsApp Business pas encore « Live » → ajoutez le numéro dans
#   Meta Business Suite > WhatsApp > API Setup > numéros de test.
# - Vérifiez le même numéro que test_whatsapp_otp.js (ex. 22959399349).
# - Messages OTP parfois dans « Mises à jour » / conversation Tranoo Business.

# --- Enregistrement numéro WhatsApp Business (script test_whatsapp_register_pin.js) ---
VERIFY_PIN=123456

# --- PDF rapport vérification (Meta ne peut pas lire Cloudinary si PDF delivery = 401) ---
# Le serveur expose une URL publique proxy (pas le CDN Cloudinary) :
#   https://api.tranoo.store/api/public/verification-reports/<token>
PUBLIC_API_BASE_URL=https://api.tranoo.store

# --- Legacy factures (autre fournisseur, non Meta Cloud) — laisser vide si non utilisé ---
# WHATSAPP_ENABLED=false
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=
